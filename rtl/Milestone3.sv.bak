

`timescale 1ns/100ps

`ifndef DISABLE_DEFAULT_NET
`default_nettype none
`endif
`include "define_state.h"

module Milestone3 (
		input logic Clock,
		input logic resetn,
		input logic M3_start,
		input logic [15:0] SRAM_read_data,
		output logic [15:0] SRAM_write_data,
		output logic SRAM_we_n,
		output logic M3_done,
		output logic [17:0] SRAM_address			
);


//DPRAM intializations

logic [7:0] address_a;  //256 locations so 8 bits required for address a and b 
logic [7:0] address_b;
	
logic [31:0] write_data_a; 
logic [31:0] write_data_b;  //32 bits of data 
	
logic [31:0] read_data_a; 
logic [31:0] read_data_b;

logic write_enable_a;
logic write_enable_b; 	

logic [15:0] value_1, value_2;

logic [2:0] variable_shift;  

assign value_1 =  $signed(shift_reg[45:44]) << variable_shift;
assign value_2 = $signed(shift_reg[45:37]) << variable_shift;

 //16 bit output of program 

logic [7:0] address;

M3_state_type M3_state;

logic [47:0] shift_reg;
logic [15:0] memory_data;
logic mode; 

logic [4:0] shift_counter; // number of bits that has already shifted
logic [4:0] bit_shift_unit,bits_left, remain_bits;
logic [7:0] we_counter,zero_counter,flag; //we_counter: number of data that has written in the DPRAM

logic [5:0] block_col_index, block_row_index;

logic [3:0] row_index;  
logic [3:0] col_index; 

assign row_index = (mode) ? address[5:3] : address[7:4];
assign col_index = (mode) ? address[2:0] : address[3:0]; 

/*
always_ff @ (posedge Clock or negedge resetn) begin
	if(mode) begin 
		row_index <= address[5:3];
		col_index <= address[2:0];
	end
	else begin 
		row_index <= address[7:4];
		col_index <= address[3:0];
	end
end
*/


logic [1:0] memory_sel;
logic [47:0] SHIFT;
logic [15:0] memory_offset;
logic [15:0] write_address;
integer i;
logic [5:0] header_counter;


parameter max_col_index = 4'd11, //updated
			 u_write_offset = 16'd27648,
			 v_write_offset = 16'd41472;
		  

 
always_ff @ (posedge Clock or negedge resetn) begin
			if(resetn == 1'b0) begin
			shift_reg <= 48'd0;
			shift_counter <= 5'd0;
			//read_address <= 18'd20;
			block_row_index <= 6'd0;
			block_col_index <= 6'd0;
			memory_sel <= 2'd0;
			remain_bits <= 5'd0;
			SRAM_we_n <= 1'd1;
			bit_shift_unit <= 5'd0;
			we_counter  <= 8'd0;
			zero_counter<= 8'd0;
			M3_state <= M3_IDLE;
			M3_done <= 1'b0;
			memory_data <= 16'd0;
			bits_left <= 5'd0; 
			//SRAM_read_data <= 16'b0;
			SRAM_write_data <= 16'b0; 
			SRAM_address <= 18'b0;
			//SRAM_read_data <= 16'b0;  
			SRAM_we_n <= 1'b1;
			mode <= 1'b0;
			memory_offset <= 16'd0;
			write_address <= 16'd27648;
			
			
			end else begin
			case (M3_state)
			M3_IDLE: begin
			header_counter <= 5'd0;
			shift_reg <= 48'd0;
			shift_counter <= 5'd0;
			//header_counter <= 5'd0;
			//read_address <= 18'd0;
			block_row_index <= 6'd0;
			block_col_index <= 6'd0;
			memory_sel <= 2'd0;
			remain_bits <= 5'd0;
			bit_shift_unit <= 5'd0;
			we_counter  <= 8'd0;
			zero_counter<= 8'd0;
			M3_done <= 1'b0;
			flag <= 8'd0;
			memory_data <= 16'd0;
			bits_left <= 5'd0; 
			memory_offset <= 16'd10;
			write_address <= 16'd27648;
			M3_state <= M3_IDLE_1;
			end
			
			M3_IDLE_1: begin
			if(M3_start) begin
			//Read DE AND AD
			if(header_counter == 5'd0) begin
			SRAM_address <= memory_offset + address;
			header_counter <= header_counter + 5'd1;
			end
			else if(header_counter == 5'd1) begin
			SRAM_address <= memory_offset + address;
			header_counter <= header_counter + 5'd1;
			end 
			else 
			if(header_counter == 5'd2) begin
			SRAM_address <= memory_offset + address;
			header_counter <= header_counter + 5'd1;
			end 
			else begin
			M3_state <= S_READ_INITIAL_0;
			SRAM_address <= memory_offset + address;
			shift_reg <= {SRAM_read_data, 32'd0};
			header_counter <= 5'd0;
			end
			end
			end
			S_READ_INITIAL_0: begin
			//Read the second value
			shift_reg <= {shift_reg[47:32],SRAM_read_data, 16'd0};
			M3_state <= S_READ_INITIAL_1;
			end
			S_READ_INITIAL_1: begin
			shift_reg <= {shift_reg[47:16],SRAM_read_data};
			M3_state <= S_READ_INITIAL_2;
			end
			S_READ_INITIAL_2: begin
			//Read the second value
			memory_data <= SRAM_read_data;
			M3_state <= S_READ_2BIT;
			end
			/*S_READ_INITIAL_3: begin
			memory_data <= SRAM_read_data;
			M3_state <= S_READ_2BIT;
			end*/
			S_READ_2BIT: begin
			//check 2 bits value
			if(shift_reg [47:46] == 2'b00)
			M3_state <= S_00;
			if(shift_reg [47:46] == 2'b01)
			M3_state <= S_01;
			if(shift_reg [47:46] == 2'b10)
			M3_state <= S_10;
			if(shift_reg [47:46] == 2'b11)
			M3_state <= S_11;
			end
			
			S_00: begin //ig done? except for to figure out zig-zag and zag-zig addressing
			if(shift_reg[45:44] == 2'b00) begin // 4 zeros
			if (zero_counter < 8'd4) begin
//			SRAM_address <= write_address; //change sram address 
//			write_address <= write_address + 1'b1;
			SRAM_write_data <= 16'd0;
			SRAM_address <= address + write_address;
			SRAM_we_n <= 1'b0;
			zero_counter <= zero_counter + 8'd1; //counting for each loop
			we_counter <= we_counter + 8'd1; //# of value written into the DPRAM
			end else begin
			M3_state <= S_shift_DETECT;
			zero_counter <= 8'd0;
			shift_counter <= shift_counter + 5'd4;
			bit_shift_unit <= 5'd4;
			SRAM_we_n <= 1'b1;
			end
			end else begin //write shift_reg[29:28] n zeros
			if (zero_counter < shift_reg[45:44]) begin
//			SRAM_address <= write_address; //change sram address
	      SRAM_address <= address + write_address;
//			write_address <= write_address + 1'b1;
			SRAM_we_n <= 1'b0;
			SRAM_write_data <= 16'd0;
			zero_counter <= zero_counter + 8'd1;
			we_counter <= we_counter + 8'd1;
			end else begin
			zero_counter <= 8'd0;
			shift_counter <= shift_counter + 5'd4;
			bit_shift_unit <= 5'd4;
			SRAM_we_n <= 1'b1;
			M3_state <= S_shift_DETECT;
			end
			end
			end
			
			S_01: begin
			if(zero_counter < 8'b1) begin
			SRAM_write_data <= value_1; // haven't implemented this quantization yet!!!, a 2 bit-value multiplied and rearranged into 16 bits
			SRAM_address <= address + write_address;
//			SRAM_address <= write_address;
//			write_address <= write_address + 1'b1;
			SRAM_we_n <= 1'b0;
			zero_counter <= zero_counter + 8'd1;
			end else begin
			shift_counter <= shift_counter + 5'd4;
			bit_shift_unit <= 5'd4;
			zero_counter <= 8'd0;
			SRAM_we_n <= 1'b1;
			we_counter <= we_counter + 8'd1;
			M3_state <= S_shift_DETECT;
			end
			end
			
			S_10: begin
			if(zero_counter < 8'b1) begin
			SRAM_write_data <= value_2; // haven't implemented this quantization yet!!!, a 9 bit-value multiplied and rearranged into 16 bits
//			SRAM_address <= write_address;
//			write_address <= write_address + 1'b1;
         SRAM_address <= address + write_address;
			SRAM_we_n <= 1'b0;
			zero_counter <= zero_counter + 8'd1;
			end else begin
			shift_counter <= shift_counter + 5'd11;
			bit_shift_unit <= 5'd11;
			zero_counter <= 8'd0;
			SRAM_we_n <= 1'b1;
			we_counter <= we_counter + 8'd1;
			M3_state <= S_shift_DETECT;
			end
			end
			S_11: begin
			if(mode == 1'b0) begin
			if (we_counter < 8'd64) begin
//			SRAM_address <= write_address;
//			write_address <= write_address + 1'b1;
         SRAM_address <= address + write_address;
			SRAM_write_data <= 16'd0;
			SRAM_we_n <= 1'b0;
			//zero_counter <= zero_counter + 8'd1; //counting for each loop
			we_counter <= we_counter + 8'd1; //# of value written into the DPRAM
			end else begin
			M3_state <= S_shift_DETECT;
			zero_counter <= 8'd0;
			shift_counter <= shift_counter + 5'd2; //need this?
			bit_shift_unit <= 5'd2; //need this? or update?
			SRAM_we_n <= 1'b1;
			end
			end else begin
			if (we_counter < 8'd256) begin
//			SRAM_address <= write_address;
//			write_address <= write_address + 1'b1;
			SRAM_address <= address + write_address;
			SRAM_write_data <= 16'd0;
			SRAM_we_n <= 1'b0;
			//zero_counter <= zero_counter + 8'd1; //counting for each loop
			we_counter <= we_counter + 8'd1; //# of value written into the DPRAM
			end else begin
			M3_state <= S_shift_DETECT;
			zero_counter <= 8'd0;
			shift_counter <= shift_counter + 5'd2; //need this?
			bit_shift_unit <= 5'd2; //need this? or update?
			SRAM_we_n <= 1'b1;
			end
			end
			end
			
			S_shift_DETECT: begin
			//shift register here
			shift_reg <= SHIFT;
			memory_data <= memory_data << bit_shift_unit;
			if (shift_counter > 5'd16) begin
			//shift the register and write sram-read data
			SRAM_address <= memory_offset + address;
			bits_left <= shift_counter - 5'd16;
			end
			M3_state <= S_BLOCK_END_DETECT;
			end
			
			S_BLOCK_END_DETECT: begin
			//detect the end of the block
			SRAM_we_n <= 1'b1;
			if(mode == 1'b0) begin
			if (we_counter == 8'd256) begin
			/////////////////update block index//////////////////
			if(block_col_index == max_col_index) begin
			if (block_row_index == 4'd8) begin
			memory_sel <= memory_sel + 2'd1;
			mode <= 1'b1;
			block_row_index <= 6'd0;
			block_col_index <= 6'd0;
			memory_offset <= memory_offset + 16'd256;
			end else begin
			block_row_index <= block_row_index + 6'd1; 
			block_col_index <= 6'd0;
			if (shift_counter > 5'd16) begin
			M3_state <= S_WAIT; //to read SRAM_READ_data
			end else begin
			M3_state <= S_READ_2BIT;
			end
			end
			end else begin
			block_col_index <= block_col_index + 6'd1;
			if (shift_counter > 5'd16) begin
			M3_state <= S_WAIT; //to read SRAM_READ_data
			end else begin
			M3_state <= S_READ_2BIT;
			end
			end
			we_counter <= 8'd0;
			end else begin
			if (shift_counter > 5'd16) begin
			
			M3_state <= S_WAIT; //to read SRAM_READ_data
			end else begin
			M3_state <= S_READ_2BIT;
			end
			end
			end
			else begin
			if (we_counter == 8'd64) begin
			/////////////////update block index//////////////////
			if(block_col_index == max_col_index) begin
			if (block_row_index == 5'd17) begin
			memory_sel <= memory_sel + 2'd1;
			block_row_index <= 6'd0;
			block_col_index <= 6'd0;
			memory_offset <= memory_offset + 16'd64;
			if (memory_sel == 2'd2)begin
			M3_state <= M3_IDLE;
			M3_done <= 1'b1;
			end
			end else begin
			block_row_index <= block_row_index + 6'd1;
			block_col_index <= 6'd0;
			if (shift_counter > 5'd16) begin
			M3_state <= S_WAIT; //to read SRAM_READ_data
			end else begin
			M3_state <= S_READ_2BIT;
			end
			end
			end else begin
			block_col_index <= block_col_index + 6'd1;
			if (shift_counter > 5'd16) begin
			M3_state <= S_WAIT; //to read SRAM_READ_data
			end else begin
			M3_state <= S_READ_2BIT;
			end
			end
			we_counter <= 8'd0;
			end else begin
			if (shift_counter > 5'd16) begin
			M3_state <= S_WAIT; //to read SRAM_READ_data
			end else begin
			M3_state <= S_READ_2BIT;
			end
			end
			end
			end
			S_WAIT: begin
			if(zero_counter < 8'd2)
			zero_counter <= zero_counter + 8'd1;
			if(zero_counter == 8'd1) begin
			shift_counter <= 5'd0;
			memory_data <= SRAM_read_data; 
			end
			else begin
			/*if(remain_bits == bits_left) begin
			zero_counter <= 8'd0;
			//remain_bits <= 5'd0;
			M3_state <= S_READ_2BIT;
			end else begin*/
			//remain_bits <= remain_bits + 5'd1;
			//if(bits_left == 5'd1) begin
			//shift_reg[0] <= memory_data[15];
			//memory_data <= memory_data << 1;
			//shift_counter <= shift_counter + 5'd1;
			//end else begin
			if(bits_left > 5'd0) begin
			shift_reg <= {shift_reg[46:0],memory_data[15]};
			bits_left <= bits_left - 1'b1;
			//shift_reg[0] <= memory_data[15];
			memory_data <= memory_data << 1;
			shift_counter <= shift_counter + 5'd1;
			end
			else begin 
			M3_state <= S_READ_2BIT;
			zero_counter <= 8'd0;
			end
			end
			end
			//end
			default: M3_state <= M3_IDLE;
			endcase
			end 
			end
			
always_comb begin
SHIFT = shift_reg;
if (bit_shift_unit == 5'd2) begin
SHIFT = {shift_reg[45:0],memory_data[15:14]};
end else if (bit_shift_unit == 5'd3) begin
SHIFT = {shift_reg[44:0],memory_data[15:13]};
end else if (bit_shift_unit == 5'd4) begin
SHIFT = {shift_reg[43:0],memory_data[15:12]};
end else if (bit_shift_unit == 5'd5) begin
SHIFT = {shift_reg[42:0],memory_data[15:11]};
end else if (bit_shift_unit == 5'd7) begin
SHIFT = {shift_reg[40:0],memory_data[15:9]};
end else if (bit_shift_unit == 5'd8) begin
SHIFT = {shift_reg[39:0],memory_data[15:8]};
end else if (bit_shift_unit == 5'd11) begin
SHIFT = {shift_reg[36:0],memory_data[15:5]};
end 
end

//logic[8:0] inputValue; //9 bit input of program

 
//logic block_flag; //0 is Y //1 is U or V 



//assign value = $signed(inputValue << variable_shift) //value for dpram



//according to mic 19 bitsetream the quantization matrix 0 will be used


always_comb begin  

//Determine variable shift 


	if (mode) begin 

	//U and V block 
	
		if ((row_index + col_index) <= 5'd10) begin 
			
	
			variable_shift = 3'd4;
			
			if ((row_index + col_index) <= 5'd6) begin 
				
				variable_shift = 3'd3;
				
			end
		
			
		end else begin 
		
			variable_shift = 3'd5;
			
		end


	end else begin 

		//Y block
		if ((row_index + col_index) <= 5'd18) begin 

			variable_shift = 3'd4;

			end else begin

			variable_shift = 3'd5;

		end

	end


end





logic dir;

always_ff @ (posedge Clock or negedge resetn) begin 


	if (resetn == 1'b0) begin

	address <= 8'd0;
	dir <= 1'b0;
	 
	 end else begin 
	 
	 if(M3_start) begin
	 if(~SRAM_we_n || (M3_state == M3_IDLE_1) )begin //if write enable is 0 
		if (mode) begin 
		
		
			
			if ((row_index == 4'd0 || row_index == 4'd7) && (col_index[0] == 1'b1)) begin 
			
			
				//if (col_index[0] == 1'b1) begin //if coloumn is even ??? (ODD?)
					
					address <= address + 1'b1;
					dir <= ~dir;	
					
				//end
				
			end 
			
			else if ((col_index == 4'd0 || col_index == 4'd7) && (row_index[0] == 1'b0)) begin 
				
				//if (row_index[0] == 1'b0) begin //odd row_index
					
					address <= address + 8'd8;
					dir <= ~dir;
					
				//end
						
			end 
			
			
			
			else begin 
			
			
				if (dir) begin 
					address <= address - 8'd7;
				
				end else begin 
				
					address <= address + 8'd7;
				end
				
			
			end
		
			
		
		end else begin 
		
		
			if ((row_index == 4'd0 || row_index == 4'd15) && (col_index[0] == 1'b0)) begin 
			
			
				//if (col_index[0] == 1'b0) begin //if coloumn is even 
					
					address <= address + 8'b1;
					dir <= ~dir;	
					
				//end
				
			end 
			
			else if ((col_index == 4'd0 || col_index == 4'd15) && (row_index[0] == 1'b1)) begin 
				
				//if (row_index[0] == 1'b1) begin //odd row_index
					
					address <= address + 8'd16;
					dir <= ~dir;
				//end
						
			end 
			
			
			else begin 
			
			
				if (dir) begin 
					address <= address + 8'd15;
				
				end else begin 
				
					address <= address - 8'd15;
				end
				

			end

		end
	end
	
	end
	
	end

end













endmodule

