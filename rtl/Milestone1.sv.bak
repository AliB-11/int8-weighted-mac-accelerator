`timescale 1ns/100ps
`ifndef DISABLE_DEFAULT_NET
`default_nettype none
`endif

`include "define_state.h"

//module for milestone 1 
module Milestone1 (
   input  logic            clock,
   input  logic            resetn,
	input  logic            start_signal, //input logic to start milestone 1 code
	input  logic   [15:0]   SRAM_read_data,
	
	
   output logic   [17:0]   SRAM_address,
	output logic   [15:0]   SRAM_write_data,
	output logic            SRAM_w_en,
	output logic            end_signal 	//output logic to declare milestone 1 is complete 

   
);

//VGA_SRAM_state_type VGA_SRAM_state;
M1_state_type M1_state; 



logic [31:0] R_odd; 
logic [31:0] R_even; 
logic [31:0] G_odd; 
logic [31:0] G_even; 
logic [31:0] B_odd; 
logic [31:0] B_even; 
logic [31:0] Y_odd; 
logic [31:0] Y_even; 
logic [31:0] U_odd; 
logic [31:0] V_odd; 
logic [31:0] U_reg [9:0];
logic [31:0] V_reg [9:0];


//clipped values
logic [7:0] R_even_clip; 
logic [7:0] R_odd_clip;
logic [7:0] G_even_clip;
logic [7:0] G_odd_clip;
logic [7:0] B_even_clip;
logic [7:0] B_odd_clip;

logic[17:0] RGB_offset; 
logic[17:0] Y_offset; 
logic[17:0] U_offset; 
logic[17:0] V_offset; 


logic [31:0] accum_1, accum_2;


logic flag_1; //no writing in first common case cc
logic flag_2; 

logic [31:0] mult_op_1_1, mult_op_1_2, mult_op_2_1, mult_op_2_2, mult_op_3_1 , mult_op_3_2, mult_op_4_1, mult_op_4_2; 

logic [63:0] Mult_result_long_1, Mult_result_long_2, Mult_result_long_3, Mult_result_long_4;

logic [31:0] Mult_result_1, Mult_result_2, Mult_result_3, Mult_result_4;


assign Mult_result_long_1 = mult_op_1_1 * mult_op_1_2; 

assign Mult_result_long_2 = mult_op_2_1 * mult_op_2_2;

assign Mult_result_long_3 = mult_op_3_1 * mult_op_3_2; 

assign Mult_result_long_4 = mult_op_4_1 * mult_op_4_2; 



assign Mult_result_1 = Mult_result_long_1[31:0];

assign Mult_result_2 = Mult_result_long_2[31:0];

assign Mult_result_3 = Mult_result_long_3[31:0];

assign Mult_result_4 = Mult_result_long_4[31:0];



//clipping 

always_comb begin
	if (R_odd[31] == 1'b1) //this is a negative value
		R_odd_clip = 8'd0; 
	else if (|R_odd[30:23])    //highest value for R_odd is 1111 1111 for 8 bit so if any bit from 30->24 = 1 we should cut to 255
		 R_odd_clip = 8'd255; 
	else 
		R_odd_clip = R_odd[22:15]; //keep value otherwise 
end

always_comb begin
	if (R_even[31] == 1'b1) 
		R_even_clip = 8'd0; 
	else if (|R_even[30:23])   
		 R_even_clip = 8'd255; 
	else 
		R_even_clip = R_even[22:15]; 
end

always_comb begin
	if (G_even[31] == 1'b1) 
		G_even_clip = 8'd0; 
	else if (|G_even[30:23])    
		 G_even_clip = 8'd255; 
	else 
		G_even_clip = G_even[22:15]; 
end

always_comb begin
	if (G_odd[31] == 1'b1) 
		G_odd_clip = 8'd0; 
	else if (|G_odd[30:23])   
		 G_odd_clip = 8'd255; 
	else 
		G_odd_clip = G_odd[22:15];
end

always_comb begin
	if (B_odd[31] == 1'b1) 
		B_odd_clip = 8'd0; 
	else if (|B_odd[30:23])   
		 B_odd_clip = 8'd255; 
	else 
		B_odd_clip = B_odd[22:15]; 
end


always_comb begin
	if (B_even[31] == 1'b1)
		B_even_clip = 8'd0; 
	else if (|B_even[30:23])    
		 B_even_clip = 8'd255; 
	else 
		B_even_clip = B_even[22:15]; 
end



//row counter 

logic[7:0] row_counter; 

logic[7:0] col_counter; 

//should keep track of the amount of Y U and V values are read in each row; 
//would help for the common case when we check for when to transition to lead out 

//keep track of Y,U and V offsets


always_ff @(posedge clock or negedge resetn) begin
	if(!resetn) begin
		M1_state <= S_IDLE_M1;
		SRAM_address <= 18'b0;
      SRAM_write_data <= 16'b0;
      SRAM_w_en <= 1'b1; 
		//offset registers 
		Y_offset <= 18'd0; 
		U_offset <= 18'd0; 
		V_offset <= 18'd0; 
		RGB_offset <= 18'd0; 
		end_signal <= 1'd0;
		flag_2 <= 1'b1;
		flag_1 <= 1'b1;
		
	   U_reg[0] <= 32'd0;
		U_reg[1] <= 32'd0;
		U_reg[2] <= 32'd0;
		U_reg[3] <= 32'd0;
		U_reg[4] <= 32'd0;
		U_reg[5] <= 32'd0;
		U_reg[6] <= 32'd0;
		U_reg[7] <= 32'd0;
		U_reg[8] <= 32'd0;
		U_reg[9] <= 32'd0;
		
		V_reg[0] <= 32'd0;
		V_reg[1] <= 32'd0;
		V_reg[2] <= 32'd0;
		V_reg[3] <= 32'd0;
		V_reg[4] <= 32'd0;
		V_reg[5] <= 32'd0;
		V_reg[6] <= 32'd0;
		V_reg[7] <= 32'd0;
		V_reg[8] <= 32'd0;
		V_reg[9] <= 32'd0;
		
		row_counter <= 8'd0;
		col_counter <= 8'd0;
		
		Y_odd <= 32'd0;
		U_odd <= 32'd0; 
		V_odd <= 32'd0; 
		Y_even <= 32'd0; 
		
		mult_op_1_1 <= 32'd0;
		mult_op_1_2 <= 32'd0;
		mult_op_2_1 <= 32'd0;
		mult_op_2_2 <= 32'd0;
		mult_op_3_1 <= 32'd0;
		mult_op_3_2 <= 32'd0;
		mult_op_4_1 <= 32'd0;
		mult_op_4_2 <= 32'd0;
		
		 accum_1 <= 32'd0; 
		 accum_2 <= 32'd0; 
		 
		R_odd <= 32'd0; 
		R_even <= 32'd0; 
		G_odd <= 32'd0; 
		G_even <= 32'd0; 
		B_odd <= 32'd0; 
		B_even <= 32'd0; 
		 
		 

		
		//add flags here
	end else begin
	//begin FSM 
		case (M1_state)
		
		S_IDLE_M1: begin 
			
			SRAM_address <= 18'b0;
			SRAM_write_data <= 16'b0;
			SRAM_w_en <= 1'b1; //read 
			//offset registers
			Y_offset <= 18'd0; 
			U_offset <= 18'd13824; 
			V_offset <= 18'd20736; 
			RGB_offset <= 18'd220672; 
			Y_odd <= 32'd0;
			U_odd <= 32'd0; 
			V_odd <= 32'd0; 
			Y_even <= 32'd0; 
			flag_2 <= 1'b1;
		   flag_1 <= 1'b1;
			row_counter <= 8'd0;
		   if (start_signal == 1'b1) 
				begin 
					M1_state <= S_LI0;
				end
			end
		
			
		S_LI0: begin 
			SRAM_w_en <= 1'b1; //initiate read
			
			SRAM_address <= Y_offset; //read Y
			Y_offset <= Y_offset + 1;
			col_counter <= 8'd0;
			
			//col_counter <= col_counter + 1; Did I implement this? Why?
			
		  row_counter <= row_counter + 1; 
		
			
			M1_state <= S_LI1; 
			
		end
		
		
		S_LI1: begin 
			
			SRAM_address <= U_offset; //read U
			U_offset <= U_offset + 1;	
			M1_state <= S_LI2; 
		
		end
		
		S_LI2: begin 
		
			SRAM_address <= V_offset; //read V
			V_offset <= V_offset + 1;	
			M1_state <= S_LI3; 
			
		end
		
		S_LI3: begin
			
			SRAM_address <= U_offset; //read U
			U_offset <= U_offset + 1;	
			
				
			Y_even <= SRAM_read_data[15:8] - 32'sd16;  //buffer Y values 
			Y_odd <=  SRAM_read_data[7:0] - 32'sd16; 
			
			M1_state <= S_LI4; 
			
		
		end
		
		S_LI4: begin
			
			SRAM_address <= V_offset; //read V
			V_offset <= V_offset + 1;	
		
			
			//store U values in U register
			
			U_reg[9] <= SRAM_read_data[15:8];
			U_reg[8] <= SRAM_read_data[15:8];
			U_reg[7] <= SRAM_read_data[15:8];
			U_reg[6] <= SRAM_read_data[15:8];
			U_reg[5] <= SRAM_read_data[15:8];
			U_reg[4] <= SRAM_read_data[7:0];
			
			M1_state <= S_LI5; 
	
		end
		
		
		
		S_LI5: begin
			
			SRAM_address <= U_offset; 
			U_offset <= U_offset + 1;	
			
			V_reg[9] <= SRAM_read_data[15:8];
			V_reg[8] <= SRAM_read_data[15:8];
			V_reg[7] <= SRAM_read_data[15:8];
			V_reg[6] <= SRAM_read_data[15:8];
			V_reg[5] <= SRAM_read_data[15:8];
			V_reg[4] <= SRAM_read_data[7:0]; 
			
	
			M1_state <= S_LI6; 
	
		end
		
		
		S_LI6: begin
			SRAM_address <= V_offset; //read V
			V_offset <= V_offset + 1;	
			
			U_reg[3] <= SRAM_read_data[15:8]; //U2
			U_reg[2] <= SRAM_read_data[7:0]; //U3
			
			M1_state <= S_LI7; 
			
		end
		
		
		S_LI7: begin
			
			
			V_reg[3] <= SRAM_read_data[15:8]; 
			V_reg[2] <= SRAM_read_data[7:0]; 
			
			M1_state <= S_LI8; 
			
		end
		
		
		S_LI8: begin
		
			U_reg[1] <= SRAM_read_data[15:8]; //U4
			U_reg[0] <= SRAM_read_data[7:0]; //U5
		
		
				M1_state <= S_LI9; 
		end
		
		
		S_LI9: begin
			V_reg[1] <= SRAM_read_data[15:8]; //V4
			V_reg[0] <= SRAM_read_data[7:0];
			
			flag_1 <= 1'b1; 
			flag_2 <= 1'b1;
		
			M1_state <= S_CC0; 
			
		end

		S_CC0: begin 
		
		if(!flag_1)begin
		
		G_odd <= (G_odd - Mult_result_1 - Mult_result_2);  //>>>15 removed due to clipping 
		B_odd <= (G_odd + Mult_result_3); 
		
		//EXTRACT V
		
		
		if(flag_2 && col_counter <= 8'd89) begin
		
//		V_reg <= {V_reg[9:1], {{24{SRAM_read_data[15]}}, SRAM_read_data[15:8]}};
		V_odd <= SRAM_read_data[7:0];
		//V_reg[9:0][31:0] <= {V_reg[9:1][31:0], $signed(SRAM_read_data[15:8])};
		
		V_reg[9] <= V_reg[8]; 
		V_reg[8] <= V_reg[7];
		V_reg[7] <= V_reg[6];
		V_reg[6] <= V_reg[5]; 
		V_reg[5] <= V_reg[4];
		V_reg[4] <= V_reg[3];
		V_reg[3] <= V_reg[2]; 
		V_reg[2] <= V_reg[1];
		V_reg[1] <= V_reg[0];
		V_reg[0] <= SRAM_read_data[15:8];

		flag_2 <= 1'b0;
		end
		else begin 
		V_reg[9] <= V_reg[8]; 
		V_reg[8] <= V_reg[7];
		V_reg[7] <= V_reg[6];
		V_reg[6] <= V_reg[5]; 
		V_reg[5] <= V_reg[4]; 
		V_reg[4] <= V_reg[3];
		V_reg[3] <= V_reg[2]; 
		V_reg[2] <= V_reg[1];
		V_reg[1] <= V_reg[0];
		V_reg[0] <= V_odd;
		
//		V_reg <= {V_reg[9:1], V_odd};
		//V_reg[9:0][31:0] <= {V_reg[9:1][31:0], V_odd}; //Doesn't matter if it runs in col_counter = 95, as it gets replaced anyways
		flag_2 <= 1'b1;
		
		end
		
		SRAM_w_en <= 1'b0;
		SRAM_address <= RGB_offset;
		RGB_offset <= RGB_offset + 1'b1; 
		SRAM_write_data <= {R_even_clip, G_even_clip};
		
		end 
		
		mult_op_1_1 <= 32'd36;
		mult_op_1_2 <= U_reg[0];
		
		mult_op_2_1 <= 32'd98;  //-98
		mult_op_2_2 <= U_reg[1]; 
		
		mult_op_3_1 <= 32'd233; //-233
		mult_op_3_2 <= U_reg[2];
		
		mult_op_4_1 <= 32'd528;
		mult_op_4_2 <= U_reg[3]; 
		
		
		accum_1 <= 32'd2048; 
		
		M1_state <= S_CC1;
		end 
		
		S_CC1: begin 
		
		//In the second state, write to the second address, perform the second Uodd operations. U4U5U6U7
		//, all multiplications are performed on 32 bits, requiring zero or sign extension of the operand
		
		if(!flag_1)begin
		SRAM_address <= RGB_offset; 
		RGB_offset <= RGB_offset + 1'b1; 
		SRAM_write_data <= {B_even_clip, R_odd_clip};
		end
		mult_op_1_1 <= 32'd1815;
		mult_op_1_2 <= U_reg[4];
		
		mult_op_2_1 <= 32'd1815;
		mult_op_2_2 <= U_reg[5]; 
		
		mult_op_3_1 <= 32'd528;
		mult_op_3_2 <= U_reg[6];
		
		mult_op_4_1 <= 32'd233; //-233
		mult_op_4_2 <= U_reg[7]; 
		
		
		accum_1 <= accum_1 + Mult_result_1 - Mult_result_2 - Mult_result_3 + Mult_result_4; //U0-U3
		
		
		M1_state <= S_CC2;
		
		end 
		
		S_CC2: begin 
		if(!flag_1)begin
		SRAM_address <= RGB_offset; 
		RGB_offset <= RGB_offset + 1'b1; 
		SRAM_write_data <= {G_odd_clip, B_odd_clip};
		
		Y_even <= SRAM_read_data[15:8] - 8'd16; 
		Y_odd <= SRAM_read_data[7:0] - 8'd16; 
		
		end
		if(col_counter == 8'd96)begin 
		M1_state <= S_LI0; 
		if (row_counter == 8'd144) 
		begin 
			M1_state <= S_IDLE_M1;
			end_signal <= 1'd1;
			
		end
		end 
		
		else begin
		mult_op_1_1 <= 32'd98; //-98
		mult_op_1_2 <= U_reg[8];
		
		mult_op_2_1 <= 32'd36;
		mult_op_2_2 <= U_reg[9]; 
		
		mult_op_3_1 <= 32'd36;
		mult_op_3_2 <= V_reg[0];
		
		mult_op_4_1 <= 32'd98; //-98
		mult_op_4_2 <= V_reg[1]; 
		
		accum_1 <= accum_1 + Mult_result_1 + Mult_result_2 + Mult_result_3 - Mult_result_4; //U4-U7
		accum_2 <= 32'd2048; //repeat 
		
		M1_state <= S_CC3;
		end
		end 
		
		S_CC3: begin 
		
		SRAM_w_en <= 1'b1;
		
		mult_op_1_1 <= 32'd233; //-233
		mult_op_1_2 <= V_reg[2];
		
		mult_op_2_1 <= 32'd528;
		mult_op_2_2 <= V_reg[3]; 
		
		mult_op_3_1 <= 32'd1815;
		mult_op_3_2 <= V_reg[4];
		
		mult_op_4_1 <= 32'd1815;
		mult_op_4_2 <= V_reg[5]; 
		
		accum_1 <= (accum_1 - Mult_result_1 + Mult_result_2)>>>12; //U8-U9 THIS MIGHT BE TOO SLOW (TIMING ERRORS!!!), Otherwise U' completed
		accum_2 <= accum_2 + Mult_result_3 - Mult_result_4; 
		
		M1_state <= S_CC4;
		end 
		
		S_CC4: begin 
		
		if(flag_2 && col_counter <= 8'd88) begin //U_offset stays where it is
		SRAM_address <= U_offset; 
		U_offset <= U_offset + 1'b1;
		end
		
		mult_op_1_1 <= 32'd528;
		mult_op_1_2 <= V_reg[6];
		
		mult_op_2_1 <= 32'd233; //-233
		mult_op_2_2 <= V_reg[7]; 
		
		mult_op_3_1 <= 32'd98; //-98
		mult_op_3_2 <= V_reg[8];
		
		mult_op_4_1 <= 32'd36;
		mult_op_4_2 <= V_reg[9]; 
		
		accum_2 <= accum_2 - Mult_result_1 + Mult_result_2 + Mult_result_3 + Mult_result_4; 
		
		
		M1_state <= S_CC5;
		end 
		
		S_CC5: begin 
		
		if(flag_2 && col_counter <= 8'd88)begin //V_offset stays where it is
		SRAM_address <= V_offset; 
		V_offset <= V_offset + 1'b1;
		end
		
		//Need to reuse Y partial product, so save it separately (?)
		//R(EVEN)G(EVEN)
		
		mult_op_1_1 <= 32'd38142;
		mult_op_1_2 <= Y_even;
		
		mult_op_2_1 <= 32'd52298;
		mult_op_2_2 <= V_reg[5] - 32'd128; //-18
		
		mult_op_3_1 <= 32'd12845; // -12845
		mult_op_3_2 <= U_reg[5] - 32'd128;
		
		mult_op_4_1 <= 32'd26640; //-26640
		mult_op_4_2 <= V_reg[5] - 32'd128; 

		accum_2 <= (accum_2 + Mult_result_1 - Mult_result_2 - Mult_result_3 + Mult_result_4)>>>12; 
		
		M1_state <= S_CC6; 
		end
		
		S_CC6: begin 
		
		R_even <= (Mult_result_1 + Mult_result_2 + 32'sd16384); //>>>15 //FIX - to + 
		G_even <= (Mult_result_1 - Mult_result_3 - Mult_result_4 + 32'd16384); //>>>15
		B_even <= Mult_result_1 + 32'd16384; //continue in next
		
		mult_op_1_1 <= 32'd66093;
		mult_op_1_2 <= U_reg[5] - 32'd128; 
		
		mult_op_2_1 <= 32'd38142; 
		mult_op_2_2 <= Y_odd; //common Y partial factor
		
		mult_op_3_1 <= 32'd52298;
		mult_op_3_2 <= accum_2 - 32'd128; 
		
		
		
		M1_state <= S_CC7; 
		end
		
		S_CC7: begin 
		
		//EXTRACT U
		
		if(col_counter <= 8'd94) begin
		SRAM_address <= Y_offset; //Keeps incrementing, stop at 94, as next write is last write
		Y_offset <= Y_offset + 1'b1;
		end
		
		if(flag_1)begin 
		flag_1 <= 1'b0;
		end
		
		
		if(flag_2 && col_counter <= 8'd88) begin
		U_odd <= SRAM_read_data[7:0];
//		U_reg <= {U_reg[9:1], {{24{SRAM_read_data[15]}}, SRAM_read_data[15:8]}};
		//U_reg[9:0][31:0] <= {U_reg[9:1][31:0], $signed(SRAM_read_data[15:8])};
		U_reg[9] <= U_reg[8]; 
		U_reg[8] <= U_reg[7];
		U_reg[7] <= U_reg[6];
		U_reg[6] <= U_reg[5]; 
		U_reg[5] <= U_reg[4];
		U_reg[4] <= U_reg[3];
		U_reg[3] <= U_reg[2]; 
		U_reg[2] <= U_reg[1];
		U_reg[1] <= U_reg[0];
		U_reg[0] <= SRAM_read_data[15:8];
		
		
		
		end 
		else begin 
//		U_reg <= {U_reg[9:1], U_odd};
		//U_reg[9:0][31:0] <= {U_reg[9:1][31:0], U_odd};
		
		U_reg[9] <= U_reg[8]; 
		U_reg[8] <= U_reg[7];
		U_reg[7] <= U_reg[6];
		U_reg[6] <= U_reg[5]; 
		U_reg[5] <= U_reg[4];
		U_reg[4] <= U_reg[3];
		U_reg[3] <= U_reg[2]; 
		U_reg[2] <= U_reg[1];
		U_reg[1] <= U_reg[0];
		U_reg[0] <= U_odd;
		
		end
		
		B_even <= (B_even + Mult_result_1);   //>>> 15
		R_odd <= (Mult_result_2 + Mult_result_3 + 32'd16384);  //>>>15
		
		G_odd <= Mult_result_2 + 32'd16384;
		B_odd <= Mult_result_2 + 32'd16384;
		
		
		mult_op_1_1 <= 32'd12845; //-12845
		mult_op_1_2 <= accum_1 - 32'd128; 
		
		mult_op_2_1 <= 32'd26640; //26640
		mult_op_2_2 <= accum_2 - 32'd128; 
		
		mult_op_3_1 <= 32'd66093;
		mult_op_3_2 <= accum_1 - 32'd128; 
		
		M1_state <= S_CC0;
		
		col_counter <= col_counter + 1'b1;
		
		end 
		
		default: M1_state <= S_IDLE_M1;
		
		endcase 

	
	end
end



endmodule